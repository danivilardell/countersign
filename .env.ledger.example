# Copy to .env for a physical Ledger. See ledger/countersign-app/README.md.
COUNTERSIGN_ENABLED_PLATFORMS=ledger
COUNTERSIGN_DEV_MODE=0
COUNTERSIGN_SKIP_ATTESTATION=0
COUNTERSIGN_SKIP_INTEGRITY=0
COUNTERSIGN_API_TOKEN=
COUNTERSIGN_ADMIN_API_TOKEN=
COUNTERSIGN_DB_PATH=countersign.db

# Ledger's published root of trust is loaded from attestation_roots/ledger_root_of_trust.txt
# unless overridden here (comma-separated hex keys, or a path to a file with one per line).
# COUNTERSIGN_LEDGER_ROOT_PUBLIC_KEYS=attestation_roots/ledger_root_of_trust.txt
# Optional Owner public key(s) accepted instead of a device chain (Speculos, or a
# device provisioned with `ledger/host/endorse.py`). Leave empty for devices
# provisioned with `bridge.py provision`.
COUNTERSIGN_LEDGER_OWNER_PUBLIC_KEYS=
# SHA-256 of the Countersign Ledger app as installed: the `.sha256` file next
# to the build output, cross-checked against what `bridge.py enroll` prints.
COUNTERSIGN_LEDGER_CODE_HASH=
